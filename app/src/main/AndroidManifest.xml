<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime permission on Android 13+. Requested when the user starts a run; the timer works without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Optional calendar export, asked for only when the user turns it on. READ lists calendars and finds this app's own
        events by UID. WRITE creates, changes, and deletes those events. The app never reads other events.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
        Backups are off. Local data is tied to this device's Keystore key and to the sync session. A restored copy would
        hold queued changes and cursors without the tokens that match them.
    -->
    <application
        android:name=".RoutinePilotApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoutinePilot">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps a RUNNING routine alive in the background. Started only from the foreground; stops when paused. -->
        <service
            android:name=".infrastructure.notifications.RoutineRunService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started guided routine timer that shows a countdown and step controls while the app is in the background." />
        </service>

        <receiver
            android:name=".infrastructure.notifications.RunActionReceiver"
            android:exported="false" />

        <!--
            Widget providers. exported="false" is enough: the system's AppWidget service sends the update broadcast, and
            widget button taps go through Glance's own non-exported receiver.
        -->
        <receiver
            android:name=".infrastructure.widget.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
        <receiver
            android:name=".infrastructure.widget.RunWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_run_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/run_widget_info" />
        </receiver>
        <receiver
            android:name=".infrastructure.widget.QuickStartWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_quick_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_start_widget_info" />
        </receiver>

        <receiver
            android:name=".infrastructure.notifications.RunBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Use on-demand WorkManager initialization so the Hilt worker factory is configured in the application. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
